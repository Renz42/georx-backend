APP_NAME=MedLocator
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ==============================================================
# DATABASE CONFIGURATION
# Switch between MySQL (local) and Supabase PostgreSQL
# by changing DB_CONNECTION and the block of vars below.
# ==============================================================

# ---------------------------------------------------------------
# OPTION A: Local MySQL (XAMPP) — DEFAULT FOR LOCAL DEVELOPMENT
# ---------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=medicine_locator_db
DB_USERNAME=root
DB_PASSWORD=
DB_SSLMODE=prefer

# ---------------------------------------------------------------
# OPTION B: Supabase PostgreSQL — USE FOR PRODUCTION / STAGING
# Uncomment this block and comment out Option A above.
# Get these from: Supabase Dashboard > Project Settings > Database
# ---------------------------------------------------------------
# DB_CONNECTION=pgsql
#
# --- Direct connection (for migrations & artisan commands) ---
# DB_HOST=db.xxxxxxxxxxxxxxxxxxxx.supabase.co
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres
# DB_PASSWORD=your-supabase-db-password
# DB_SSLMODE=require
#
# --- OR: Supavisor Pooler (for web request traffic) ---
# DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
# DB_PORT=6543
# DB_DATABASE=postgres
# DB_USERNAME=postgres.xxxxxxxxxxxxxxxxxxxx
# DB_PASSWORD=your-supabase-db-password
# DB_SSLMODE=require
#
# DB_SCHEMA=public
# DB_STATEMENT_TIMEOUT=30000

# ==============================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@medicinelocator.com"
MAIL_FROM_NAME="${APP_NAME}"

MAXIM_API_URL=https://api.maxim.com
MAXIM_API_KEY=your-maxim-api-key
MAXIM_SANDBOX=true
MAXIM_WEBHOOK_SECRET=your-webhook-secret

PILOT_CENTER_LAT=10.6385
PILOT_CENTER_LNG=122.9566
PILOT_MAX_RADIUS_KM=5.0

VITE_APP_NAME="${APP_NAME}"

